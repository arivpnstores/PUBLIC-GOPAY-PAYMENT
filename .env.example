# GoPay QRIS Payment Server Configuration
# Copy this file to .env and fill in your values

# Base URL for GoMerch API
BASE_URL=https://qris.adijayavpnpedia.cloud

# Merchant ID from GoMerch
MERCHANT_ID=MERCHANT_ID

# Access Token (JWT) from GoMerch login
ACCESS_TOKEN=your_access_token_here

# Refresh Token (JWT) from GoMerch login
REFRESH_TOKEN=your_refresh_token_here

# Static QR String from GoMerch merchant settings
STATIC_QR=STATIC_QR

# Server port (default: 2007)
PORT=2007